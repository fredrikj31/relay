{
  "name": "@relay/api",
  "scripts": {
    "dev": "tsx watch --include src src/app.ts | pino-pretty",
    "build": "tsc -p tsconfig.build.json",
    "build:check": "tsc --noEmit",
    "start": "node build/app.js",
    "lint": "eslint . --max-warnings 0",
    "format:check": "prettier . --check",
    "format:write": "prettier . --write",
    "auth:generate": "pnpm dlx auth@latest generate --config src/services/auth/client.ts --output src/services/drizzle-database/schemas/auth.ts",
    "database:generate": "pnpm exec drizzle-kit generate",
    "database:migrate": "pnpm exec drizzle-kit migrate"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.9.3",
    "@types/pg": "^8.20.3",
    "dotenv": "^17.4.2",
    "drizzle-kit": "1.0.0-rc.4",
    "eslint": "^10.3.0",
    "globals": "^17.7.0",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.8.4",
    "tsx": "^4.22.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.62.1"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.2.0",
    "@fastify/swagger": "^9.7.0",
    "@scalar/fastify-api-reference": "^1.59.3",
    "better-auth": "^1.6.25",
    "drizzle-orm": "1.0.0-rc.4",
    "fastify": "^5.12.1",
    "fastify-plugin": "^5.1.0",
    "fastify-type-provider-zod": "^6.1.0",
    "pg": "^8.22.0",
    "pino": "^10.3.1",
    "slonik": "^49.10.7",
    "slonik-interceptor-field-name-transformation": "^48.14.0",
    "zod": "^4.4.3"
  }
}
